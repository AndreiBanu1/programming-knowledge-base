{
  "name": "programming-knowledge-base",
  "version": "1.0.0",
  "description": "Personal TypeScript & Python knowledge base: book exercises, worked examples, algorithms, data structures, and performance notes",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:types": "tsc --noEmit",
    "test:py": "uv run pytest",
    "lint:py": "uv run ruff check .",
    "lint:py:fix": "uv run ruff check --fix .",
    "format:py": "uv run ruff format .",
    "check": "npm run test:types && npm run test:types:nest && npm run test:run && npm run lint:py && npm run test:py",
    "dev:fastapi": "uv run fastapi dev backend/simpleFastAPI/main.py",
    "dev:jsapi": "cd backend/simpleJSApi && tsx watch server.ts",
    "test:types:nest": "tsc --noEmit -p backend/simpleNestJSApi/tsconfig.json",
    "dev:nestjs": "cd backend/simpleNestJSApi && PORT=${PORT:-3001} node --watch --import ./register.mjs src/main.ts"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.2.0",
    "@swc/core": "^1.16.18",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.9",
    "@types/supertest": "^7.2.1",
    "@vitest/ui": "^4.1.5",
    "happy-dom": "^20.10.6",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.2",
    "@scalar/nestjs-api-reference": "^1.2.30",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "overrides": {
    "@nestjs/swagger": {
      "typescript": "$typescript"
    }
  }
}
